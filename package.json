{
  "name": "uni",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": "24.13.1"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean",
    "bootstrap": "node scripts/setup.mjs",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml --env-file .env up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml --env-file .env down",
    "infra:reset": "docker compose -f infra/docker/docker-compose.yml --env-file .env down -v",
    "infra:logs": "docker compose -f infra/docker/docker-compose.yml logs -f postgres",
    "infra:psql": "docker exec -it uni-postgres psql -U jaemin -d postgres",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "turbo run db:studio",
    "graph:turbo": "node dot/scripts/gen-turbo-graph.js",
    "graph:merge": "node dot/scripts/merge-graph.js",
    "graph": "pnpm run graph:turbo && pnpm run graph:merge"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.14.0",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.0.0",
    "prettier": "^3.2.5",
    "sass": "^1.87.0",
    "ts-node": "^10.9.2",
    "turbo": "latest",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}