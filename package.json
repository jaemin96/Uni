{
  "name": "uni",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": "24.13.1"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:migrate": "turbo db:migrate --filter=@uni/db",
    "db:generate": "turbo db:generate --filter=@uni/db",
    "clean": "turbo clean",
    "graph:turbo": "node dot/scripts/gen-turbo-graph.js",
    "graph:merge": "node dot/scripts/merge-graph.js",
    "graph": "pnpm run graph:turbo && pnpm run graph:merge"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.14.0",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.0.0",
    "prettier": "^3.2.5",
    "sass": "^1.87.0",
    "ts-node": "^10.9.2",
    "turbo": "latest",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}