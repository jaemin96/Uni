{
  "files.eol": "\n",
  "editor.defaultFormatter": "fronterior.biome-monorepo",
  "editor.formatOnSave": true,
  "[typescript]": {
    "editor.defaultFormatter": "fronterior.biome-monorepo"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "fronterior.biome-monorepo"
  },
  "[javascript]": {
    "editor.defaultFormatter": "fronterior.biome-monorepo"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "fronterior.biome-monorepo"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit",
    "source.fixAll.eslint": "explicit"
  },
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "biome.enabled": false
}
